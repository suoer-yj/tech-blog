---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categorySlugMap, tagSlugMap, toPostData } from '../lib/slug-utils';

// 从 Content Collections 获取所有文章
const allPostsRaw = await getCollection('blog');

// 按日期降序排序
const allPostsRawSorted = allPostsRaw.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// 转换为前端需要的格式
const allPosts = allPostsRawSorted.map(toPostData);

// 分页配置
const POSTS_PER_PAGE = 6;
const totalPosts = allPosts.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);

// 精选文章（featured: true）
const featuredPosts = allPosts.filter(p => p.featured).slice(0, 2);
---

<BaseLayout title="首页" allPosts={allPosts}>
  <!-- Hero Section -->
  <section class="mb-12">
    <div class="bg-gradient-to-r from-primary to-blue-600 rounded-2xl p-6 md:p-8 text-white">
      <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 md:mb-4">欢迎来到技术博客</h1>
      <p class="text-blue-100 text-base md:text-lg">探索 AI 工具、编程技巧、系统优化与网络安全</p>
    </div>
  </section>

  <!-- Featured Posts (只在第一页显示) -->
  <section id="featured-section" class="mb-12">
    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10 2l2.09 5.26L18 8.27l-4 3.91 1 5.82L10 15l-5 2.91 1-5.82-4-3.91 5.91-.91L10 2z" />
      </svg>
      精选文章
    </h2>
    <div class="grid md:grid-cols-2 gap-6">
      {featuredPosts.map(post => (
        <a href={`/articles/${post.slug}`} class="card group">
          <div class="aspect-video bg-gray-200 overflow-hidden">
            <img
              src={post.image}
              alt={post.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-4">
            <div class="flex items-center gap-2 mb-2">
              <a href={`/categories/${post.categorySlug}`} class="tag">{post.category}</a>
              <span class="text-xs text-gray-400">{post.date}</span>
            </div>
            <h3 class="font-semibold text-gray-800 group-hover:text-primary transition-colors line-clamp-2">
              {post.title}
            </h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Recent Posts -->
  <section>
    <h2 id="posts-title" class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span id="posts-title-text">最新文章</span>
    </h2>
    <div id="posts-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 文章将通过 JavaScript 动态渲染 -->
    </div>
  </section>

  <!-- Pagination -->
  <div class="mt-12 flex justify-center">
    <nav id="pagination-nav" class="flex items-center gap-2 flex-wrap">
      <!-- 分页将通过 JavaScript 动态渲染 -->
    </nav>
  </div>

  <!-- 页码信息 -->
  <div class="mt-4 text-center text-sm text-gray-500">
    <span id="page-info">共 {totalPosts} 篇文章，第 1 / {totalPages} 页</span>
  </div>

  <script is:inline define:vars={{ allPosts, totalPosts, totalPages, POSTS_PER_PAGE }}>
    // 获取当前页码
    function getCurrentPage() {
      const params = new URLSearchParams(window.location.search);
      const page = parseInt(params.get('page') || '1');
      return Math.max(1, Math.min(page, totalPages));
    }

    // 生成页码数组
    function getPageNumbers(currentPage) {
      const pages = [];
      const maxVisible = 5;

      if (totalPages <= maxVisible) {
        for (let i = 1; i <= totalPages; i++) pages.push(i);
      } else {
        if (currentPage <= 3) {
          for (let i = 1; i <= 4; i++) pages.push(i);
          pages.push('...');
          pages.push(totalPages);
        } else if (currentPage >= totalPages - 2) {
          pages.push(1);
          pages.push('...');
          for (let i = totalPages - 3; i <= totalPages; i++) pages.push(i);
        } else {
          pages.push(1);
          pages.push('...');
          for (let i = currentPage - 1; i <= currentPage + 1; i++) pages.push(i);
          pages.push('...');
          pages.push(totalPages);
        }
      }
      return pages;
    }

    // 渲染文章列表
    function renderPosts(currentPage) {
      const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
      const endIndex = startIndex + POSTS_PER_PAGE;
      const currentPosts = allPosts.slice(startIndex, endIndex);

      const postsGrid = document.getElementById('posts-grid');
      postsGrid.innerHTML = currentPosts.map(post => `
        <a href="/articles/${post.slug}" class="card group">
          <div class="aspect-video bg-gray-200 overflow-hidden">
            <img
              src="${post.image}"
              alt="${post.title}"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-4">
            <div class="flex items-center gap-2 mb-2">
              <a href="/categories/${post.categorySlug}" class="tag">${post.category}</a>
              <span class="text-xs text-gray-400">${post.date}</span>
            </div>
            <h3 class="font-semibold text-gray-800 group-hover:text-primary transition-colors line-clamp-2 mb-2">
              ${post.title}
            </h3>
            <p class="text-sm text-gray-500 line-clamp-2">${post.excerpt}</p>
          </div>
        </a>
      `).join('');
    }

    // 渲染分页
    function renderPagination(currentPage) {
      const pageNumbers = getPageNumbers(currentPage);
      const paginationNav = document.getElementById('pagination-nav');

      let html = '';

      // 上一页
      if (currentPage > 1) {
        html += `<a href="/?page=${currentPage - 1}" class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors">上一页</a>`;
      } else {
        html += `<span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">上一页</span>`;
      }

      // 页码
      pageNumbers.forEach((page, index) => {
        if (page === '...') {
          html += `<span class="px-2 text-gray-400">...</span>`;
        } else if (page === currentPage) {
          html += `<span class="px-3 py-2 text-sm bg-primary text-white rounded-lg">${page}</span>`;
        } else {
          html += `<a href="/?page=${page}" class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors">${page}</a>`;
        }
      });

      // 下一页
      if (currentPage < totalPages) {
        html += `<a href="/?page=${currentPage + 1}" class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors">下一页</a>`;
      } else {
        html += `<span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">下一页</span>`;
      }

      paginationNav.innerHTML = html;
    }

    // 更新页面状态
    function updatePage() {
      const currentPage = getCurrentPage();

      // 渲染文章
      renderPosts(currentPage);

      // 渲染分页
      renderPagination(currentPage);

      // 更新标题
      const postsTitleText = document.getElementById('posts-title-text');
      postsTitleText.textContent = currentPage === 1 ? '最新文章' : `文章列表 - 第 ${currentPage} 页`;

      // 更新页码信息
      const pageInfo = document.getElementById('page-info');
      pageInfo.textContent = `共 ${totalPosts} 篇文章，第 ${currentPage} / ${totalPages} 页`;

      // 控制精选文章显示（只在第一页显示）
      const featuredSection = document.getElementById('featured-section');
      if (featuredSection) {
        featuredSection.style.display = currentPage === 1 ? 'block' : 'none';
      }
    }

    // 初始化
    updatePage();

    // 监听 URL 变化（处理浏览器前进/后退）
    window.addEventListener('popstate', updatePage);
  </script>
</BaseLayout>
