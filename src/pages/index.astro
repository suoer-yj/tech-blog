// 分页配置
const POSTS_PER_PAGE = 6;
const totalPosts = allPosts.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);

// 获取当前页码（从 URL 查询参数）
const url = new URL(Astro.request.url);
const currentPage = Math.max(1, Math.min(parseInt(url.searchParams.get('page') || '1'), totalPages));

// 计算当前页的文章
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const endIndex = startIndex + POSTS_PER_PAGE;
const currentPosts = allPosts.slice(startIndex, endIndex);

// 前2篇作为精选文章
const featuredPosts = allPosts.slice(0, 2);

// 生成页码数组
const getPageNumbers = () => {
  const pages = [];
  const maxVisible = 5;
  
  if (totalPages <= maxVisible) {
    for (let i = 1; i <= totalPages; i++) pages.push(i);
  } else {
    if (currentPage <= 3) {
      for (let i = 1; i <= 4; i++) pages.push(i);
      pages.push('...');
      pages.push(totalPages);
    } else if (currentPage >= totalPages - 2) {
      pages.push(1);
      pages.push('...');
      for (let i = totalPages - 3; i <= totalPages; i++) pages.push(i);
    } else {
      pages.push(1);
      pages.push('...');
      for (let i = currentPage - 1; i <= currentPage + 1; i++) pages.push(i);
      pages.push('...');
      pages.push(totalPages);
    }
  }
  return pages;
};

const pageNumbers = getPageNumbers();
---

<BaseLayout title="首页">
  <!-- Hero Section -->
  <section class="mb-12">
    <div class="bg-gradient-to-r from-primary to-blue-600 rounded-2xl p-6 md:p-8 text-white">
      <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-3 md:mb-4">欢迎来到技术博客</h1>
      <p class="text-blue-100 text-base md:text-lg">探索 AI 工具、编程技巧、系统优化与网络安全</p>
    </div>
  </section>

  <!-- Featured Posts (只在第一页显示) -->
  {currentPage === 1 && (
    <section class="mb-12">
      <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
        <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2l2.09 5.26L18 8.27l-4 3.91 1 5.82L10 15l-5 2.91 1-5.82-4-3.91 5.91-.91L10 2z" />
        </svg>
        精选文章
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        {featuredPosts.map(post => (
          <a href={`/articles/${post.slug}`} class="card group">
            <div class="aspect-video bg-gray-200 overflow-hidden">
              <img 
                src={post.image} 
                alt={post.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="p-4">
              <div class="flex items-center gap-2 mb-2">
                <span class="tag">{post.category}</span>
                <span class="text-xs text-gray-400">{post.date}</span>
              </div>
              <h3 class="font-semibold text-gray-800 group-hover:text-primary transition-colors line-clamp-2">
                {post.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Recent Posts -->
  <section>
    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center gap-2">
      <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      {currentPage === 1 ? '最新文章' : `文章列表 - 第 ${currentPage} 页`}
    </h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {currentPosts.map(post => (
        <a href={`/articles/${post.slug}`} class="card group">
          <div class="aspect-video bg-gray-200 overflow-hidden">
            <img 
              src={post.image} 
              alt={post.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-4">
            <div class="flex items-center gap-2 mb-2">
              <span class="tag">{post.category}</span>
              <span class="text-xs text-gray-400">{post.date}</span>
            </div>
            <h3 class="font-semibold text-gray-800 group-hover:text-primary transition-colors line-clamp-2 mb-2">
              {post.title}
            </h3>
            <p class="text-sm text-gray-500 line-clamp-2">{post.excerpt}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Pagination -->
  {totalPages > 1 && (
    <div class="mt-12 flex justify-center">
      <nav class="flex items-center gap-2 flex-wrap">
        <!-- 上一页 -->
        {currentPage > 1 ? (
          <a 
            href={`/?page=${currentPage - 1}`}
            class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors"
          >
            上一页
          </a>
        ) : (
          <span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">
            上一页
          </span>
        )}

        <!-- 页码 -->
        {pageNumbers.map((page, index) => (
          page === '...' ? (
            <span key={`ellipsis-${index}`} class="px-2 text-gray-400">...</span>
          ) : (
            page === currentPage ? (
              <span 
                key={page}
                class="px-3 py-2 text-sm bg-primary text-white rounded-lg"
              >
                {page}
              </span>
            ) : (
              <a 
                key={page}
                href={`/?page=${page}`}
                class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors"
              >
                {page}
              </a>
            )
          )
        ))}

        <!-- 下一页 -->
        {currentPage < totalPages ? (
          <a 
            href={`/?page=${currentPage + 1}`}
            class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors"
          >
            下一页
          </a>
        ) : (
          <span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">
            下一页
          </span>
        )}
      </nav>
    </div>
  )}

  <!-- 页码信息 -->
  <div class="mt-4 text-center text-sm text-gray-500">
    共 {totalPosts} 篇文章，第 {currentPage} / {totalPages} 页
  </div>
</BaseLayout>
