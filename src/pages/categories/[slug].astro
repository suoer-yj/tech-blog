---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const categories = ['ai', 'claude', 'openai', 'windows', 'security', 'resources'];
  return categories.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;

const categoryNames: Record<string, string> = {
  'ai': 'AI',
  'claude': 'Claude',
  'openai': 'OpenAI',
  'windows': 'Windows',
  'security': '网络安全',
  'resources': '免费资源'
};

// 该分类下的所有文章
const allCategoryPosts = [
  { title: 'Windows 本地 AI 又升级了！llama.cpp 官方支持 CUDA 13 / Vulkan / HIP / SYCL，一键跑 GGUF 无审查模型！', date: '2026-05-18', slug: 'windows-local-ai-llama-cpp-upgrade', image: 'https://picsum.photos/seed/ai1/400/200', category: 'AI' },
  { title: 'Claude Code + Ollama 太强了！免费本地 AI 开发助手来了！', date: '2026-05-15', slug: 'claude-code-ollama-local-ai', image: 'https://picsum.photos/seed/claude/400/200', category: 'Claude' },
  { title: 'Windows 11 最完整备份与还原教程', date: '2026-05-14', slug: 'windows-11-backup-restore-guide', image: 'https://picsum.photos/seed/win11/400/200', category: 'Windows' },
  { title: 'BitLocker 被 5 分钟绕过？', date: '2026-05-12', slug: 'bitlocker-downgrade-attack', image: 'https://picsum.photos/seed/security/400/200', category: '网络安全' },
  { title: 'AI 开发包大规模投毒事件分析', date: '2026-05-12', slug: 'npm-ai-packages-supply-chain-attack', image: 'https://picsum.photos/seed/npm/400/200', category: 'AI' },
  { title: 'Sulphur 2 AI 视频模型本地部署实测', date: '2026-05-11', slug: 'sulphur-2-ai-video-model', image: 'https://picsum.photos/seed/video/400/200', category: 'AI' },
  { title: 'Bitcoin 挖矿进入低利润时代？', date: '2026-05-11', slug: 'bitcoin-mining-low-profit-era', image: 'https://picsum.photos/seed/bitcoin/400/200', category: '挖矿' },
  { title: '紧急预警！JDownloader 下载器遭黑客入侵', date: '2026-05-11', slug: 'jdownloader-hack-warning', image: 'https://picsum.photos/seed/jdownloader/400/200', category: '网络安全' },
];

// 分页配置
const POSTS_PER_PAGE = 6;
const totalPosts = allCategoryPosts.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);
---

<BaseLayout title={`${categoryNames[slug] || slug} - 分类`}>
  <!-- Breadcrumb -->
  <nav class="mb-6 text-sm">
    <ol class="flex items-center gap-2 text-gray-500">
      <li><a href="/" class="hover:text-primary">首页</a></li>
      <li>/</li>
      <li class="text-gray-800">分类</li>
      <li>/</li>
      <li class="text-gray-800">{categoryNames[slug] || slug}</li>
    </ol>
  </nav>

  <!-- Header -->
  <header class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">
      分类: {categoryNames[slug] || slug}
    </h1>
    <p class="text-gray-500">
      共 {totalPosts} 篇文章
    </p>
  </header>

  <!-- Posts Grid -->
  <div id="posts-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- 文章将通过 JavaScript 动态渲染 -->
  </div>

  <!-- Pagination -->
  <div class="mt-12 flex justify-center">
    <nav id="pagination-nav" class="flex items-center gap-2 flex-wrap">
      <!-- 分页将通过 JavaScript 动态渲染 -->
    </nav>
  </div>

  <!-- 页码信息 -->
  <div class="mt-4 text-center text-sm text-gray-500">
    <span id="page-info">共 {totalPosts} 篇文章，第 1 / {totalPages} 页</span>
  </div>

  <script is:inline define:vars={{ allCategoryPosts, totalPosts, totalPages, POSTS_PER_PAGE, slug }}>
    // 获取当前页码
    function getCurrentPage() {
      const params = new URLSearchParams(window.location.search);
      const page = parseInt(params.get('page') || '1');
      return Math.max(1, Math.min(page, totalPages));
    }

    // 生成页码数组
    function getPageNumbers(currentPage) {
      const pages = [];
      const maxVisible = 5;
      
      if (totalPages <= maxVisible) {
        for (let i = 1; i <= totalPages; i++) pages.push(i);
      } else {
        if (currentPage <= 3) {
          for (let i = 1; i <= 4; i++) pages.push(i);
          pages.push('...');
          pages.push(totalPages);
        } else if (currentPage >= totalPages - 2) {
          pages.push(1);
          pages.push('...');
          for (let i = totalPages - 3; i <= totalPages; i++) pages.push(i);
        } else {
          pages.push(1);
          pages.push('...');
          for (let i = currentPage - 1; i <= currentPage + 1; i++) pages.push(i);
          pages.push('...');
          pages.push(totalPages);
        }
      }
      return pages;
    }

    // 渲染文章列表
    function renderPosts(currentPage) {
      const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
      const endIndex = startIndex + POSTS_PER_PAGE;
      const currentPosts = allCategoryPosts.slice(startIndex, endIndex);
      
      const postsGrid = document.getElementById('posts-grid');
      postsGrid.innerHTML = currentPosts.map(post => `
        <a href="/articles/${post.slug}" class="card group">
          <div class="aspect-video bg-gray-200 overflow-hidden">
            <img 
              src="${post.image}" 
              alt="${post.title}"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
          </div>
          <div class="p-4">
            <span class="text-xs text-gray-400 mb-2 block">${post.date}</span>
            <h2 class="font-semibold text-gray-800 group-hover:text-primary transition-colors line-clamp-2">
              ${post.title}
            </h2>
          </div>
        </a>
      `).join('');
    }

    // 渲染分页
    function renderPagination(currentPage) {
      const pageNumbers = getPageNumbers(currentPage);
      const paginationNav = document.getElementById('pagination-nav');
      
      let html = '';
      
      // 上一页
      if (currentPage > 1) {
        html += `<a href="/categories/${slug}?page=${currentPage - 1}" class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors">上一页</a>`;
      } else {
        html += `<span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">上一页</span>`;
      }
      
      // 页码
      pageNumbers.forEach((page) => {
        if (page === '...') {
          html += `<span class="px-2 text-gray-400">...</span>`;
        } else if (page === currentPage) {
          html += `<span class="px-3 py-2 text-sm bg-primary text-white rounded-lg">${page}</span>`;
        } else {
          html += `<a href="/categories/${slug}?page=${page}" class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors">${page}</a>`;
        }
      });
      
      // 下一页
      if (currentPage < totalPages) {
        html += `<a href="/categories/${slug}?page=${currentPage + 1}" class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors">下一页</a>`;
      } else {
        html += `<span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">下一页</span>`;
      }
      
      paginationNav.innerHTML = html;
    }

    // 更新页面状态
    function updatePage() {
      const currentPage = getCurrentPage();
      
      // 渲染文章
      renderPosts(currentPage);
      
      // 渲染分页
      renderPagination(currentPage);
      
      // 更新页码信息
      const pageInfo = document.getElementById('page-info');
      pageInfo.textContent = `共 ${totalPosts} 篇文章，第 ${currentPage} / ${totalPages} 页`;
    }

    // 初始化
    updatePage();

    // 监听 URL 变化（处理浏览器前进/后退）
    window.addEventListener('popstate', updatePage);
  </script>
</BaseLayout>
