---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { categorySlugMap, tagSlugMap, slugToCategoryName, toPostData, type PostData } from '../../lib/slug-utils';
import VideoEmbed from '../../components/VideoEmbed.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const slug = post.id.replace(/\.md$/, '');
const categorySlug = categorySlugMap[post.data.category] || post.data.category.toLowerCase();

// 解析文章中的视频标记，并记录位置
// 支持格式：<!-- video:youtube:VIDEO_ID:标题 --> 或 <!-- video:bilibili:BVID:标题 -->
const videoRegex = /<!--\s*video:(youtube|bilibili):([^\s:]+)(?::([^\n]+?))?\s*-->/g;

// 将视频标记替换为占位符，并收集视频信息
let contentBody = post.body;
const videos: { index: number; platform: 'youtube' | 'bilibili'; id: string; title: string }[] = [];
let matchIndex = 0;

contentBody = contentBody.replace(videoRegex, (match, platform, id, title) => {
  const placeholder = `<!--VIDEO_PLACEHOLDER_${matchIndex}-->`;
  videos.push({
    index: matchIndex,
    platform: platform as 'youtube' | 'bilibili',
    id: id.trim(),
    title: (title || '视频').trim()
  });
  matchIndex++;
  return placeholder;
});

// 重新渲染修改后的内容
// 我们需要在渲染后的 HTML 中替换占位符
const { Content: ContentWithPlaceholders } = await render({
  ...post,
  body: contentBody
});

// 获取所有文章用于侧边栏和相关推荐
const allPostsRaw = await getCollection('blog');
const allPosts = allPostsRaw.map(toPostData).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// 相关文章：同分类的其他文章
const relatedPosts = allPosts
  .filter(p => p.slug !== slug && p.category === post.data.category)
  .slice(0, 3);

// 如果同分类不够，补充其他文章
if (relatedPosts.length < 3) {
  const otherPosts = allPosts
    .filter(p => p.slug !== slug && !relatedPosts.find(r => r.slug === p.slug))
    .slice(0, 3 - relatedPosts.length);
  relatedPosts.push(...otherPosts);
}

const detailImage = post.data.image.replace('800/400', '1200/600');
---

<BaseLayout title={post.data.title} description={post.data.excerpt} image={post.data.image} allPosts={allPosts}>
  <article>
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm">
      <ol class="flex items-center gap-2 text-gray-500">
        <li><a href="/" class="hover:text-primary">首页</a></li>
        <li>/</li>
        <li><a href={`/categories/${categorySlug}`} class="hover:text-primary">{post.data.category}</a></li>
        <li>/</li>
        <li class="text-gray-800 truncate max-w-xs">{post.data.title}</li>
      </ol>
    </nav>

    <!-- Article Header -->
    <header class="mb-8">
      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags.map(tag => {
          const tSlug = tagSlugMap[tag] || tag.toLowerCase();
          return (
            <a href={`/tags/${tSlug}`} class="tag">{tag}</a>
          );
        })}
      </div>

      <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 mb-4">
        {post.data.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          {post.data.author}
        </span>
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {post.data.date}
        </span>
      </div>
    </header>

    <!-- Featured Image -->
    <figure class="mb-8 rounded-xl overflow-hidden">
      <img src={detailImage} alt={post.data.title} class="w-full" />
    </figure>

    <!-- Article Content with Videos -->
    <div class="prose-article article-content">
      <ContentWithPlaceholders />
    </div>

    <!-- Video Components (hidden, will be moved by JS) -->
    <div id="video-components" class="hidden">
      {videos.map(video => (
        <div data-video-index={video.index} class="video-wrapper">
          <VideoEmbed 
            platform={video.platform} 
            id={video.id} 
            title={video.title}
          />
        </div>
      ))}
    </div>

    <!-- Tags -->
    <div class="mt-8 pt-8 border-t">
      <div class="flex flex-wrap gap-2">
        <span class="text-gray-500">标签：</span>
        {post.data.tags.map(tag => {
          const tSlug = tagSlugMap[tag] || tag.toLowerCase();
          return (
            <a href={`/tags/${tSlug}`} class="tag">{tag}</a>
          );
        })}
      </div>
    </div>

    <!-- Comments (Placeholder) -->
    <div class="mt-8 pt-8 border-t">
      <h3 class="text-lg font-semibold mb-4">评论</h3>
      <div class="bg-gray-50 rounded-lg p-6 text-center text-gray-500">
        <p>评论功能已集成 Giscus</p>
        <p class="text-sm mt-2">使用 GitHub 账号登录后可发表评论</p>
      </div>
    </div>
  </article>

  <!-- Related Posts -->
  {relatedPosts.length > 0 && (
    <section class="mt-12">
      <h3 class="text-lg font-semibold mb-6">相关推荐</h3>
      <div class="grid md:grid-cols-3 gap-4">
        {relatedPosts.map(related => (
          <a href={`/articles/${related.slug}`} class="card group">
            <div class="aspect-video bg-gray-200 overflow-hidden">
              <img src={related.image.replace('800/400', '400/200')} alt={related.title} class="w-full h-full object-cover" />
            </div>
            <div class="p-3">
              <h4 class="text-sm font-medium text-gray-800 group-hover:text-primary line-clamp-2">
                {related.title}
              </h4>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <script define:vars={{ videoCount: videos.length }}>
    // 页面加载后将视频组件移动到正确的位置
    document.addEventListener('DOMContentLoaded', () => {
      const articleContent = document.querySelector('.article-content');
      const videoComponents = document.getElementById('video-components');
      
      if (!articleContent || !videoComponents) return;
      
      // 查找所有占位符并替换为对应的视频组件
      for (let i = 0; i < videoCount; i++) {
        const placeholderText = `<!--VIDEO_PLACEHOLDER_${i}-->`;
        const placeholder = findPlaceholder(articleContent, placeholderText);
        const videoWrapper = videoComponents.querySelector(`[data-video-index="${i}"]`);
        
        if (placeholder && videoWrapper) {
          // 创建视频容器
          const videoContainer = document.createElement('div');
          videoContainer.className = 'my-6';
          videoContainer.innerHTML = videoWrapper.innerHTML;
          
          // 替换占位符
          placeholder.replaceWith(videoContainer);
        }
      }
      
      // 清理隐藏的容器
      videoComponents.remove();
    });
    
    // 辅助函数：查找包含特定文本的元素
    function findPlaceholder(container, text) {
      // 首先尝试查找包含该文本的 p 标签
      const paragraphs = container.querySelectorAll('p');
      for (const p of paragraphs) {
        if (p.textContent.trim() === text) {
          return p;
        }
      }
      
      // 如果没找到，使用 TreeWalker 遍历所有文本节点
      const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, null, false);
      let node;
      while (node = walker.nextNode()) {
        if (node.textContent.includes(text)) {
          // 返回包含该文本节点的段落或元素
          let parent = node.parentElement;
          while (parent && parent !== container) {
            if (parent.tagName === 'P' || parent.tagName === 'DIV') {
              return parent;
            }
            parent = parent.parentElement;
          }
          return node.parentElement;
        }
      }
      return null;
    }
  </script>
</BaseLayout>
