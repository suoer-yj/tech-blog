---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const tags = ['ai', 'claude', 'openai', 'windows', 'security', 'resources', 'python'];
  return tags.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;

const tagNames: Record<string, string> = {
  'ai': 'AI',
  'claude': 'Claude',
  'openai': 'OpenAI',
  'windows': 'Windows',
  'security': '网络安全',
  'resources': '免费资源',
  'python': 'Python'
};

// 该标签下的所有文章
const allTagPosts = [
  { title: 'Windows 本地 AI 又升级了！llama.cpp 官方支持 CUDA 13 / Vulkan / HIP / SYCL，一键跑 GGUF 无审查模型！', date: '2026-05-18', slug: 'windows-local-ai-llama-cpp-upgrade', image: 'https://picsum.photos/seed/ai1/400/200', category: 'AI' },
  { title: 'Claude Code + Ollama 太强了！免费本地 AI 开发助手来了！', date: '2026-05-15', slug: 'claude-code-ollama-local-ai', image: 'https://picsum.photos/seed/claude/400/200', category: 'Claude' },
  { title: 'Windows 11 最完整备份与还原教程', date: '2026-05-14', slug: 'windows-11-backup-restore-guide', image: 'https://picsum.photos/seed/win11/400/200', category: 'Windows' },
  { title: 'BitLocker 被 5 分钟绕过？', date: '2026-05-12', slug: 'bitlocker-downgrade-attack', image: 'https://picsum.photos/seed/security/400/200', category: '网络安全' },
  { title: 'AI 开发包大规模投毒事件分析', date: '2026-05-12', slug: 'npm-ai-packages-supply-chain-attack', image: 'https://picsum.photos/seed/npm/400/200', category: 'AI' },
  { title: 'Sulphur 2 AI 视频模型本地部署实测', date: '2026-05-11', slug: 'sulphur-2-ai-video-model', image: 'https://picsum.photos/seed/video/400/200', category: 'AI' },
  { title: 'Bitcoin 挖矿进入低利润时代？', date: '2026-05-11', slug: 'bitcoin-mining-low-profit-era', image: 'https://picsum.photos/seed/bitcoin/400/200', category: '挖矿' },
  { title: '紧急预警！JDownloader 下载器遭黑客入侵', date: '2026-05-11', slug: 'jdownloader-hack-warning', image: 'https://picsum.photos/seed/jdownloader/400/200', category: '网络安全' },
];

// 分页配置
const POSTS_PER_PAGE = 6;
const totalPosts = allTagPosts.length;
const totalPages = Math.ceil(totalPosts / POSTS_PER_PAGE);

// 获取当前页码（从 URL 查询参数）
const url = new URL(Astro.request.url);
const currentPage = Math.max(1, Math.min(parseInt(url.searchParams.get('page') || '1'), totalPages));

// 计算当前页的文章
const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
const endIndex = startIndex + POSTS_PER_PAGE;
const currentPosts = allTagPosts.slice(startIndex, endIndex);

// 生成页码数组
const getPageNumbers = () => {
  const pages = [];
  const maxVisible = 5;
  
  if (totalPages <= maxVisible) {
    for (let i = 1; i <= totalPages; i++) pages.push(i);
  } else {
    if (currentPage <= 3) {
      for (let i = 1; i <= 4; i++) pages.push(i);
      pages.push('...');
      pages.push(totalPages);
    } else if (currentPage >= totalPages - 2) {
      pages.push(1);
      pages.push('...');
      for (let i = totalPages - 3; i <= totalPages; i++) pages.push(i);
    } else {
      pages.push(1);
      pages.push('...');
      for (let i = currentPage - 1; i <= currentPage + 1; i++) pages.push(i);
      pages.push('...');
      pages.push(totalPages);
    }
  }
  return pages;
};

const pageNumbers = getPageNumbers();
---

<BaseLayout title={`${tagNames[slug] || slug} - 标签`}>
  <!-- Breadcrumb -->
  <nav class="mb-6 text-sm">
    <ol class="flex items-center gap-2 text-gray-500">
      <li><a href="/" class="hover:text-primary">首页</a></li>
      <li>/</li>
      <li><a href="/tags" class="hover:text-primary">标签</a></li>
      <li>/</li>
      <li class="text-gray-800">{tagNames[slug] || slug}</li>
    </ol>
  </nav>

  <!-- Header -->
  <header class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">
      标签: {tagNames[slug] || slug}
    </h1>
    <p class="text-gray-500">
      共 {totalPosts} 篇文章
    </p>
  </header>

  <!-- Posts Grid -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {currentPosts.map(post => (
      <a href={`/articles/${post.slug}`} class="card group">
        <div class="aspect-video bg-gray-200 overflow-hidden">
          <img 
            src={post.image} 
            alt={post.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        </div>
        <div class="p-4">
          <span class="text-xs text-gray-400 mb-2 block">{post.date}</span>
          <h2 class="font-semibold text-gray-800 group-hover:text-primary transition-colors line-clamp-2">
            {post.title}
          </h2>
        </div>
      </a>
    ))}
  </div>

  <!-- Pagination -->
  {totalPages > 1 && (
    <div class="mt-12 flex justify-center">
      <nav class="flex items-center gap-2 flex-wrap">
        <!-- 上一页 -->
        {currentPage > 1 ? (
          <a 
            href={`/tags/${slug}?page=${currentPage - 1}`}
            class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors"
          >
            上一页
          </a>
        ) : (
          <span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">
            上一页
          </span>
        )}

        <!-- 页码 -->
        {pageNumbers.map((page, index) => (
          page === '...' ? (
            <span key={`ellipsis-${index}`} class="px-2 text-gray-400">...</span>
          ) : (
            page === currentPage ? (
              <span 
                key={page}
                class="px-3 py-2 text-sm bg-primary text-white rounded-lg"
              >
                {page}
              </span>
            ) : (
              <a 
                key={page}
                href={`/tags/${slug}?page=${page}`}
                class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors"
              >
                {page}
              </a>
            )
          )
        ))}

        <!-- 下一页 -->
        {currentPage < totalPages ? (
          <a 
            href={`/tags/${slug}?page=${currentPage + 1}`}
            class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors"
          >
            下一页
          </a>
        ) : (
          <span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">
            下一页
          </span>
        )}
      </nav>
    </div>
  )}

  <!-- 页码信息 -->
  <div class="mt-4 text-center text-sm text-gray-500">
    共 {totalPosts} 篇文章，第 {currentPage} / {totalPages} 页
  </div>
</BaseLayout>
