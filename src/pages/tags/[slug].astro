---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categorySlugMap, tagSlugMap, slugToTagName, toPostData } from '../../lib/slug-utils';

export async function getStaticPaths() {
  const allPostsRaw = await getCollection('blog');

  // 获取所有唯一的标签 slug
  const allTagSlugs = [...new Set(allPostsRaw.flatMap(p => p.data.tags.map(t => tagSlugMap[t] || t.toLowerCase())))];

  // 获取所有文章（用于侧边栏）
  const allPosts = allPostsRaw.map(toPostData).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

  return allTagSlugs.map(slug => {
    const tagName = slugToTagName[slug] || slug;
    const allTagPosts = allPosts.filter(p => p.tags.some(t => (tagSlugMap[t] || t.toLowerCase()) === slug));
    const totalPosts = allTagPosts.length;
    const totalPages = Math.ceil(totalPosts / 6);

    return {
      params: { slug },
      props: { tagName, allTagPosts, allPosts, totalPosts, totalPages }
    };
  });
}

const { slug } = Astro.params;
const { tagName, allTagPosts, allPosts, totalPosts, totalPages } = Astro.props;

const POSTS_PER_PAGE = 6;
---

<BaseLayout title={`${tagName} - 标签`} allPosts={allPosts}>
  <!-- Breadcrumb -->
  <nav class="mb-6 text-sm">
    <ol class="flex items-center gap-2 text-gray-500">
      <li><a href="/" class="hover:text-primary">首页</a></li>
      <li>/</li>
      <li><a href="/tags" class="hover:text-primary">标签</a></li>
      <li>/</li>
      <li class="text-gray-800">{tagName}</li>
    </ol>
  </nav>

  <!-- Header -->
  <header class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">
      标签: {tagName}
    </h1>
    <p class="text-gray-500">
      共 {totalPosts} 篇文章
    </p>
  </header>

  <!-- Posts Grid -->
  <div id="posts-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
  </div>

  <!-- Pagination -->
  <div class="mt-12 flex justify-center">
    <nav id="pagination-nav" class="flex items-center gap-2 flex-wrap">
    </nav>
  </div>

  <!-- 页码信息 -->
  <div class="mt-4 text-center text-sm text-gray-500">
    <span id="page-info">共 {totalPosts} 篇文章，第 1 / {totalPages} 页</span>
  </div>

  <script is:inline define:vars={{ allTagPosts, totalPosts, totalPages, POSTS_PER_PAGE, slug }}>
    function getCurrentPage() {
      const params = new URLSearchParams(window.location.search);
      const page = parseInt(params.get('page') || '1');
      return Math.max(1, Math.min(page, totalPages));
    }

    function getPageNumbers(currentPage) {
      const pages = [];
      const maxVisible = 5;
      if (totalPages <= maxVisible) {
        for (let i = 1; i <= totalPages; i++) pages.push(i);
      } else {
        if (currentPage <= 3) {
          for (let i = 1; i <= 4; i++) pages.push(i);
          pages.push('...');
          pages.push(totalPages);
        } else if (currentPage >= totalPages - 2) {
          pages.push(1);
          pages.push('...');
          for (let i = totalPages - 3; i <= totalPages; i++) pages.push(i);
        } else {
          pages.push(1);
          pages.push('...');
          for (let i = currentPage - 1; i <= currentPage + 1; i++) pages.push(i);
          pages.push('...');
          pages.push(totalPages);
        }
      }
      return pages;
    }

    function renderPosts(currentPage) {
      const startIndex = (currentPage - 1) * POSTS_PER_PAGE;
      const endIndex = startIndex + POSTS_PER_PAGE;
      const currentPosts = allTagPosts.slice(startIndex, endIndex);
      const postsGrid = document.getElementById('posts-grid');
      postsGrid.innerHTML = currentPosts.map(post => `
        <a href="/articles/${post.slug}" class="card group">
          <div class="aspect-video bg-gray-200 overflow-hidden">
            <img src="${post.image}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-4">
            <span class="text-xs text-gray-400 mb-2 block">${post.date}</span>
            <h2 class="font-semibold text-gray-800 group-hover:text-primary transition-colors line-clamp-2">${post.title}</h2>
          </div>
        </a>
      `).join('');
    }

    function renderPagination(currentPage) {
      const pageNumbers = getPageNumbers(currentPage);
      const paginationNav = document.getElementById('pagination-nav');
      let html = '';
      if (currentPage > 1) {
        html += `<a href="/tags/${slug}?page=${currentPage - 1}" class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors">上一页</a>`;
      } else {
        html += `<span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">上一页</span>`;
      }
      pageNumbers.forEach((page) => {
        if (page === '...') {
          html += `<span class="px-2 text-gray-400">...</span>`;
        } else if (page === currentPage) {
          html += `<span class="px-3 py-2 text-sm bg-primary text-white rounded-lg">${page}</span>`;
        } else {
          html += `<a href="/tags/${slug}?page=${page}" class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors">${page}</a>`;
        }
      });
      if (currentPage < totalPages) {
        html += `<a href="/tags/${slug}?page=${currentPage + 1}" class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 transition-colors">下一页</a>`;
      } else {
        html += `<span class="px-3 py-2 text-sm border rounded-lg opacity-50 cursor-not-allowed">下一页</span>`;
      }
      paginationNav.innerHTML = html;
    }

    function updatePage() {
      const currentPage = getCurrentPage();
      renderPosts(currentPage);
      renderPagination(currentPage);
      const pageInfo = document.getElementById('page-info');
      pageInfo.textContent = `共 ${totalPosts} 篇文章，第 ${currentPage} / ${totalPages} 页`;
    }

    updatePage();
    window.addEventListener('popstate', updatePage);
  </script>
</BaseLayout>
