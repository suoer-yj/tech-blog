---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const tags = ['ai', 'claude', 'openai', 'windows', 'security', 'resources', 'python'];
  return tags.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;

const tagNames: Record<string, string> = {
  'ai': 'AI',
  'claude': 'Claude',
  'openai': 'OpenAI',
  'windows': 'Windows',
  'security': '网络安全',
  'resources': '免费资源',
  'python': 'Python'
};

const tagPosts = [
  { title: 'Windows 本地 AI 又升级了！llama.cpp 官方支持 CUDA 13 / Vulkan / HIP / SYCL，一键跑 GGUF 无审查模型！', date: '2026-05-18', slug: 'windows-local-ai-llama-cpp-upgrade', image: 'https://picsum.photos/seed/ai1/400/200' },
  { title: 'Claude Code + Ollama 太强了！免费本地 AI 开发助手来了！', date: '2026-05-15', slug: 'claude-code-ollama-local-ai', image: 'https://picsum.photos/seed/claude/400/200' },
  { title: 'Windows 11 最完整备份与还原教程', date: '2026-05-14', slug: 'windows-11-backup-restore-guide', image: 'https://picsum.photos/seed/win11/400/200' },
  { title: 'BitLocker 被 5 分钟绕过？', date: '2026-05-12', slug: 'bitlocker-downgrade-attack', image: 'https://picsum.photos/seed/security/400/200' },
  { title: 'AI 开发包大规模投毒事件分析', date: '2026-05-12', slug: 'npm-ai-packages-supply-chain-attack', image: 'https://picsum.photos/seed/npm/400/200' },
  { title: 'Sulphur 2 AI 视频模型本地部署实测', date: '2026-05-11', slug: 'sulphur-2-ai-video-model', image: 'https://picsum.photos/seed/video/400/200' }
];
---

<BaseLayout title={`${tagNames[slug] || slug} - 标签`}>
  <!-- Breadcrumb -->
  <nav class="mb-6 text-sm">
    <ol class="flex items-center gap-2 text-gray-500">
      <li><a href="/" class="hover:text-primary">首页</a></li>
      <li>/</li>
      <li><a href="/tags" class="hover:text-primary">标签</a></li>
      <li>/</li>
      <li class="text-gray-800">{tagNames[slug] || slug}</li>
    </ol>
  </nav>

  <!-- Header -->
  <header class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">
      标签: {tagNames[slug] || slug}
    </h1>
    <p class="text-gray-500">
      共 {tagPosts.length} 篇文章
    </p>
  </header>

  <!-- Posts Grid -->
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {tagPosts.map(post => (
      <a href={`/articles/${post.slug}`} class="card group">
        <div class="aspect-video bg-gray-200 overflow-hidden">
          <img 
            src={post.image} 
            alt={post.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        </div>
        <div class="p-4">
          <span class="text-xs text-gray-400 mb-2 block">{post.date}</span>
          <h2 class="font-semibold text-gray-800 group-hover:text-primary transition-colors line-clamp-2">
            {post.title}
          </h2>
        </div>
      </a>
    ))}
  </div>

  <!-- Pagination -->
  <div class="mt-12 flex justify-center">
    <nav class="flex items-center gap-2">
      <button class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50 disabled:opacity-50" disabled>
        上一页
      </button>
      <span class="px-3 py-2 text-sm">第 1 页 / 共 2 页</span>
      <button class="px-3 py-2 text-sm border rounded-lg hover:bg-gray-50">
        下一页
      </button>
    </nav>
  </div>
</BaseLayout>
