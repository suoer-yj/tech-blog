---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categorySlugMap, tagSlugMap, toPostData } from '../../lib/slug-utils';

// 获取所有文章
const allPostsRaw = await getCollection('blog');

// 获取所有文章（用于侧边栏）
const allPosts = allPostsRaw.map(toPostData).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// 动态计算标签列表
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.tags.forEach(tag => {
    const count = tagMap.get(tag) || 0;
    tagMap.set(tag, count + 1);
  });
});
const popularTags = Array.from(tagMap.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({
    name,
    slug: tagSlugMap[name] || name.toLowerCase(),
    count,
  }));
---

<BaseLayout title="标签" allPosts={allPosts}>
  <!-- Breadcrumb -->
  <nav class="mb-6 text-sm">
    <ol class="flex items-center gap-2 text-gray-500">
      <li><a href="/" class="hover:text-primary">首页</a></li>
      <li>/</li>
      <li class="text-gray-800">标签</li>
    </ol>
  </nav>

  <!-- Header -->
  <header class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-2">标签</h1>
    <p class="text-gray-500">
      共 {popularTags.length} 个标签
    </p>
  </header>

  <!-- Tags Cloud -->
  <div class="card p-8">
    <div class="flex flex-wrap gap-3">
      {popularTags.map(tag => (
        <a
          href={`/tags/${tag.slug}`}
          class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 hover:bg-primary hover:text-white rounded-full transition-colors group"
        >
          <span>{tag.name}</span>
          <span class="text-xs opacity-60 group-hover:opacity-80">({tag.count})</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
