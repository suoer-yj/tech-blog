---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white border-t mt-auto">
  <div class="container mx-auto px-4 max-w-6xl py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-lg">T</span>
          </div>
          <span class="font-bold text-xl text-gray-800">技术博客</span>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed">
          专注于AI工具、软件开发、系统优化等技术领域的原创内容分享。
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-semibold text-gray-800 mb-4">快速链接</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="text-gray-500 hover:text-primary">首页</a></li>
          <li><a href="/categories/ai" class="text-gray-500 hover:text-primary">AI工具</a></li>
          <li><a href="/categories/resources" class="text-gray-500 hover:text-primary">免费资源</a></li>
          <li><a href="/about" class="text-gray-500 hover:text-primary">关于我们</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-semibold text-gray-800 mb-4">联系我们</h4>
        <ul class="space-y-2 text-sm text-gray-500">
          <li>邮箱: contact@example.com</li>
          <li>合作: biz@example.com</li>
        </ul>
      </div>
    </div>

    <div class="border-t mt-8 pt-8 text-center text-sm text-gray-500">
      <p>&copy; {currentYear} 技术博客. All rights reserved.</p>
    </div>
  </div>
</footer>
