---
const recentPosts = [
  { title: 'Windows 本地 AI 又升级了！llama.cpp 官方支持 CUDA 13', date: '2026-05-18', slug: 'windows-local-ai-llama-cpp-upgrade' },
  { title: 'Claude Code + Ollama 本地 AI 开发助手教程', date: '2026-05-15', slug: 'claude-code-ollama-local-ai' },
  { title: 'Windows 11 最完整备份与还原教程', date: '2026-05-14', slug: 'windows-11-backup-restore-guide' },
  { title: 'BitLocker 被 5 分钟绕过？安全风险解析', date: '2026-05-12', slug: 'bitlocker-downgrade-attack' },
  { title: 'AI 开发包大规模投毒事件分析', date: '2026-05-12', slug: 'npm-ai-packages-supply-chain-attack' }
];

const popularTags = [
  { name: 'AI', slug: 'ai', count: 45 },
  { name: 'Claude', slug: 'claude', count: 12 },
  { name: 'OpenAI', slug: 'openai', count: 18 },
  { name: 'Windows', slug: 'windows', count: 15 },
  { name: '网络安全', slug: 'security', count: 8 },
  { name: '免费资源', slug: 'resources', count: 22 },
  { name: 'Python', slug: 'python', count: 10 },
  { name: 'Mac', slug: 'mac', count: 6 }
];

const categories = [
  { name: 'AI', slug: 'ai', count: 12 },
  { name: 'OpenAI', slug: 'openai', count: 8 },
  { name: 'Claude', slug: 'claude', count: 5 },
  { name: 'Windows', slug: 'windows', count: 6 },
  { name: '网络安全', slug: 'security', count: 4 },
  { name: '免费资源', slug: 'resources', count: 9 }
];
---

<div class="space-y-6">
  <!-- Search Widget -->
  <div class="card p-4">
    <h3 class="font-semibold text-gray-800 mb-4">搜索</h3>
    <div class="relative">
      <input 
        type="text" 
        placeholder="搜索文章..." 
        class="w-full px-4 py-2 pl-10 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary"
      />
      <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <!-- Recent Posts -->
  <div class="card p-4">
    <h3 class="font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      近期文章
    </h3>
    <ul class="space-y-3">
      {recentPosts.map(post => (
        <li>
          <a href={`/articles/${post.slug}`} class="text-sm text-gray-600 hover:text-primary line-clamp-2">
            {post.title}
          </a>
          <span class="text-xs text-gray-400">{post.date}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Categories -->
  <div class="card p-4">
    <h3 class="font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
      分类
    </h3>
    <div class="flex flex-wrap gap-2">
      {categories.map(cat => (
        <a href={`/categories/${cat.slug}`} class="tag">
          {cat.name}
          <span class="text-gray-400 ml-1">({cat.count})</span>
        </a>
      ))}
    </div>
  </div>

  <!-- Tags -->
  <div class="card p-4">
    <h3 class="font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
      标签云
    </h3>
    <div class="flex flex-wrap gap-2">
      {popularTags.map(tag => (
        <a href={`/tags/${tag.slug}`} class="tag text-xs">
          {tag.name}
        </a>
      ))}
    </div>
  </div>
</div>
