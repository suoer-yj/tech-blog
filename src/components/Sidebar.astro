---
import { categorySlugMap, tagSlugMap, type PostData } from '../lib/slug-utils';

interface Props {
  allPosts?: PostData[];
}

const { allPosts = [] } = Astro.props;

// 动态计算近期文章（取前 5 篇）
const recentPosts = allPosts.slice(0, 5);

// 动态计算分类列表
const categoryMap = new Map<string, number>();
allPosts.forEach(post => {
  const count = categoryMap.get(post.category) || 0;
  categoryMap.set(post.category, count + 1);
});
const categories = Array.from(categoryMap.entries()).map(([name, count]) => ({
  name,
  slug: categorySlugMap[name] || name.toLowerCase(),
  count,
}));

// 动态计算标签列表
const tagMap = new Map<string, number>();
allPosts.forEach(post => {
  post.tags.forEach(tag => {
    const count = tagMap.get(tag) || 0;
    tagMap.set(tag, count + 1);
  });
});
const popularTags = Array.from(tagMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10)
  .map(([name, count]) => ({
    name,
    slug: tagSlugMap[name] || name.toLowerCase(),
    count,
  }));

// 将文章数据传递给客户端脚本
const postsJson = JSON.stringify(allPosts);
---

<div class="space-y-6">
  <!-- Search Widget -->
  <div class="card p-4">
    <h3 class="font-semibold text-gray-800 mb-4">搜索</h3>
    <div class="relative">
      <input
        id="search-input"
        type="text"
        placeholder="搜索文章..."
        class="w-full px-4 py-2 pl-10 text-sm border border-gray-200 rounded-lg focus:outline-none focus:border-primary"
        autocomplete="off"
      />
      <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <!-- 搜索结果下拉框 -->
    <div id="search-results" class="hidden mt-2 max-h-60 overflow-y-auto border border-gray-200 rounded-lg bg-white shadow-lg">
      <!-- 搜索结果将在这里动态显示 -->
    </div>
  </div>

  <!-- Recent Posts -->
  <div class="card p-4">
    <h3 class="font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      近期文章
    </h3>
    <ul class="space-y-3">
      {recentPosts.map(post => (
        <li>
          <a href={`/articles/${post.slug}`} class="text-sm text-gray-600 hover:text-primary line-clamp-2">
            {post.title}
          </a>
          <span class="text-xs text-gray-400">{post.date}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Categories -->
  <div class="card p-4">
    <h3 class="font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
      分类
    </h3>
    <div class="flex flex-wrap gap-2">
      {categories.map(cat => (
        <a href={`/categories/${cat.slug}`} class="tag">
          {cat.name}
          <span class="text-gray-400 ml-1">({cat.count})</span>
        </a>
      ))}
    </div>
  </div>

  <!-- Tags -->
  <div class="card p-4">
    <h3 class="font-semibold text-gray-800 mb-4 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
      标签云
    </h3>
    <div class="flex flex-wrap gap-2">
      {popularTags.map(tag => (
        <a href={`/tags/${tag.slug}`} class="tag text-xs">
          {tag.name}
        </a>
      ))}
    </div>
  </div>
</div>

<script is:inline define:vars={{ postsJson }}>
  // 解析文章数据
  const allPosts = JSON.parse(postsJson);
  
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  
  // 搜索函数
  function searchPosts(query) {
    if (!query || query.trim() === '') {
      return [];
    }
    
    const lowerQuery = query.toLowerCase().trim();
    
    return allPosts.filter(post => {
      // 搜索标题
      if (post.title.toLowerCase().includes(lowerQuery)) {
        return true;
      }
      // 搜索摘要
      if (post.excerpt && post.excerpt.toLowerCase().includes(lowerQuery)) {
        return true;
      }
      // 搜索分类
      if (post.category.toLowerCase().includes(lowerQuery)) {
        return true;
      }
      // 搜索标签
      if (post.tags.some(tag => tag.toLowerCase().includes(lowerQuery))) {
        return true;
      }
      return false;
    }).slice(0, 10); // 最多显示10条结果
  }
  
  // 显示搜索结果
  function displayResults(results) {
    if (results.length === 0) {
      searchResults.innerHTML = '<div class="p-3 text-sm text-gray-500">未找到相关文章</div>';
      searchResults.classList.remove('hidden');
      return;
    }
    
    const html = results.map(post => `
      <a href="/articles/${post.slug}" class="block p-3 hover:bg-gray-50 border-b border-gray-100 last:border-b-0">
        <div class="text-sm font-medium text-gray-800 line-clamp-1">${post.title}</div>
        <div class="text-xs text-gray-400 mt-1">${post.category} · ${post.date}</div>
      </a>
    `).join('');
    
    searchResults.innerHTML = html;
    searchResults.classList.remove('hidden');
  }
  
  // 隐藏搜索结果
  function hideResults() {
    searchResults.classList.add('hidden');
  }
  
  // 输入事件监听
  searchInput.addEventListener('input', (e) => {
    const query = e.target.value;
    const results = searchPosts(query);
    
    if (query.trim() === '') {
      hideResults();
    } else {
      displayResults(results);
    }
  });
  
  // 键盘导航
  let selectedIndex = -1;
  searchInput.addEventListener('keydown', (e) => {
    const items = searchResults.querySelectorAll('a');
    
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      selectedIndex = Math.min(selectedIndex + 1, items.length - 1);
      updateSelection(items);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      selectedIndex = Math.max(selectedIndex - 1, -1);
      updateSelection(items);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (selectedIndex >= 0 && items[selectedIndex]) {
        items[selectedIndex].click();
      } else if (items[0]) {
        items[0].click();
      }
    } else if (e.key === 'Escape') {
      hideResults();
      searchInput.blur();
    }
  });
  
  function updateSelection(items) {
    items.forEach((item, index) => {
      if (index === selectedIndex) {
        item.classList.add('bg-blue-50');
      } else {
        item.classList.remove('bg-blue-50');
      }
    });
  }
  
  // 点击外部隐藏搜索结果
  document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target) && !searchResults.contains(e.target)) {
      hideResults();
    }
  });
  
  // 获得焦点时如果有内容则显示结果
  searchInput.addEventListener('focus', () => {
    const query = searchInput.value;
    if (query.trim() !== '') {
      const results = searchPosts(query);
      displayResults(results);
    }
  });
</script>
